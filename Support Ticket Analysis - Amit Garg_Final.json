        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are a quality evaluator for AI-generated summaries. Score the summary on these criteria, each out of 5:\n1. Accuracy - does it correctly reflect the ticket issue?\n2. Conciseness - is it brief and free of unnecessary detail?\n3. Clarity - is it easy for a support agent to understand?\nReturn exactly in this format: Accuracy: X/5, Conciseness: X/5, Clarity: X/5, Overall: X/5. Then one sentence of reasoning."
            },
            {
              "content": "={{ $json.output[0].content[0].text }}"
            },
            {}
          ]
        },
